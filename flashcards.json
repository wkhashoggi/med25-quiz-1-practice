      "cards": [
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c01",
          "front": "What mainly controls cardiac myocyte contraction strength?",
          "back": "Extracellular Ca²⁺ influx; more Ca²⁺ has a positive inotropic effect.",
          "tags": [
            "Cardiac physiology",
            "Contractility"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c02",
          "front": "Why do Ca²⁺ channel blockers reduce cardiac contractility?",
          "back": "They reduce Ca²⁺ influx needed for excitation–contraction coupling.",
          "tags": [
            "Cardiac physiology",
            "Contractility"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c03",
          "front": "What is preload in the intact heart?",
          "back": "The resting initial fiber length, approximated by end-diastolic volume (EDV).",
          "tags": [
            "Preload"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c04",
          "front": "State the Frank–Starling law.",
          "back": "Within limits, greater initial cardiac muscle length → greater force of contraction.",
          "tags": [
            "Frank-Starling"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c05",
          "front": "How does sympathetic venoconstriction affect preload?",
          "back": "It increases venous return → increases EDV/preload.",
          "tags": [
            "Preload",
            "Venous return"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c06",
          "front": "Major factors that increase venous return?",
          "back": "Muscle pump, respiratory pump, cardiac suction, sympathetic venoconstriction, blood volume, stretchability.",
          "tags": [
            "Venous return"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c07",
          "front": "What is heterometric autoregulation?",
          "back": "Increased contractile force caused by increased EDV (Frank–Starling mechanism).",
          "tags": [
            "Autoregulation"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c08",
          "front": "What is homeometric autoregulation?",
          "back": "Increased contractile force secondary to increased aortic pressure without relying on increased fiber length.",
          "tags": [
            "Autoregulation"
          ],
          "source_url": "https://drive.google.com/file/d/16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x/view?usp=drivesdk"
        },
        {
          "id": "16rtI7UNn7_Nzr7FcTUXYvxoimQx35b5x-c09",
          "front": "Why does Frank–Starling help equalize RV and LV output?",
          "back": "More output from one side increases venous return/preload to the other side, raising its stroke volume.",
