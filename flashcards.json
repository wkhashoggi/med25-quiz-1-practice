      "cards": [
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c01",
          "front": "What is in a lipoprotein core vs shell?",
          "back": "Core: TAG + cholesteryl esters. Shell: apoproteins + phospholipids + free cholesterol.",
          "tags": [
            "Lipoproteins"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c02",
          "front": "How do size and density change from CM to HDL?",
          "back": "Size decreases while density increases: CM → VLDL → IDL → LDL → HDL.",
          "tags": [
            "Lipoproteins"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c03",
          "front": "Main job of chylomicrons?",
          "back": "Deliver dietary TAG to tissues and dietary cholesterol to the liver.",
          "tags": [
            "Chylomicrons"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c04",
          "front": "Which apoprotein is unique to nascent chylomicrons?",
          "back": "ApoB-48.",
          "tags": [
            "Chylomicrons",
            "Apolipoproteins"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c05",
          "front": "What do nascent chylomicrons acquire from HDL?",
          "back": "ApoC-II and ApoE.",
          "tags": [
            "Chylomicrons",
            "HDL"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c06",
          "front": "What activates lipoprotein lipase?",
          "back": "ApoC-II; LPL is also stimulated by insulin.",
          "tags": [
            "LPL"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c07",
          "front": "What does LPL do to chylomicrons/VLDL?",
          "back": "Hydrolyzes their TAG to fatty acids and glycerol.",
          "tags": [
            "LPL"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c08",
          "front": "How are chylomicron remnants cleared?",
          "back": "Liver receptors recognize ApoE and internalize remnants by endocytosis.",
          "tags": [
            "Chylomicrons",
            "ApoE"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c09",
          "front": "Main job of VLDL?",
          "back": "Carry endogenous TAG from liver to extrahepatic tissues.",
          "tags": [
            "VLDL"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c10",
          "front": "What is the VLDL → LDL sequence?",
          "back": "VLDL loses TAG → IDL → further delipidation → LDL.",
          "tags": [
            "VLDL",
            "IDL",
            "LDL"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c11",
          "front": "What is the only apoprotein on LDL?",
          "back": "ApoB-100.",
          "tags": [
            "LDL",
            "Apolipoproteins"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c12",
          "front": "What does the LDL receptor recognize?",
          "back": "ApoB-100 and ApoE.",
          "tags": [
            "LDL",
            "Receptor"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c13",
          "front": "What happens to excess intracellular cholesterol?",
          "back": "ACAT re-esterifies it for intracellular storage.",
          "tags": [
            "Cholesterol",
            "ACAT"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c14",
          "front": "Two key roles of HDL in lipoprotein metabolism?",
          "back": "Reservoir of ApoC-II/ApoE and mediator of reverse cholesterol transport.",
          "tags": [
            "HDL"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c15",
          "front": "What activates LCAT?",
          "back": "ApoA-I on nascent HDL.",
          "tags": [
            "HDL",
            "LCAT"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c16",
          "front": "What does LCAT do?",
          "back": "Esterifies free cholesterol on HDL, promoting HDL maturation.",
          "tags": [
            "HDL",
            "LCAT"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c17",
          "front": "How does HDL mature?",
          "back": "Nascent discoid HDL accumulates cholesteryl ester → HDL3 → HDL2.",
          "tags": [
            "HDL"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        },
        {
          "id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b-c18",
          "front": "What does CETP exchange?",
          "back": "Cholesteryl esters and triglycerides between HDL and TAG-rich lipoproteins.",
          "tags": [
            "CETP"
          ],
          "source_url": "https://drive.google.com/file/d/1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b/view?usp=drivesdk"
        }
      ]
