    {
      "id": "drive_1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV",
      "subject": "Physiology",
      "title": "Physiology of RBCs",
      "source_file_id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV",
      "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true",
      "source_modified_time": "2026-09-03T14:28:00.000Z",
      "archived": false,
      "cards": [
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c01",
          "front": "Why are RBCs biconcave?",
          "back": "To increase membrane surface area for efficient gas exchange.",
          "tags": [
            "RBC",
            "Morphology"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c02",
          "front": "Why must the RBC membrane be flexible?",
          "back": "So RBCs can deform and pass through narrow capillaries without rupturing.",
          "tags": [
            "RBC",
            "Membrane"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c03",
          "front": "What is the normal RBC lifespan?",
          "back": "About 120 days (±7 days).",
          "tags": [
            "RBC",
            "Basics"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c04",
          "front": "How is most CO₂ transported in blood?",
          "back": "About 70% as bicarbonate; ~20% binds hemoglobin as carbamino-Hb.",
          "tags": [
            "RBC",
            "CO2 transport"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c05",
          "front": "Why is carbonic anhydrase important in RBCs?",
          "back": "It rapidly supports CO₂ conversion to bicarbonate for CO₂ transport.",
          "tags": [
            "RBC",
            "CO2 transport"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c06",
          "front": "Why is G6PD important in RBCs?",
          "back": "It generates NADPH via the HMP shunt, helping maintain normal RBC fragility.",
          "tags": [
            "RBC",
            "G6PD"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c07",
          "front": "What is the main physiological trigger for erythropoiesis?",
          "back": "Tissue hypoxia.",
          "tags": [
            "RBC",
            "Erythropoiesis"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c08",
          "front": "How does hypoxia increase RBC production?",
          "back": "Hypoxia → ↑EPO → stimulation of erythropoiesis in bone marrow.",
          "tags": [
            "RBC",
            "Erythropoiesis"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c09",
          "front": "Where is most erythropoietin produced?",
          "back": "Kidney ~90%; liver ~10%.",
          "tags": [
            "RBC",
            "EPO"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c10",
          "front": "Where does adult erythropoiesis mainly occur?",
          "back": "Red marrow of flat bones plus proximal parts of long bones.",
          "tags": [
            "RBC",
            "Bone marrow"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c11",
          "front": "What supplies globin vs heme synthesis?",
          "back": "High-value protein supplies globin; iron is required for heme.",
          "tags": [
            "RBC",
            "Erythropoiesis"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c12",
          "front": "Why are vitamin B12 and folate needed for RBC production?",
          "back": "They are required for normal maturation of RBC precursors.",
          "tags": [
            "RBC",
            "Erythropoiesis"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c13",
          "front": "What happens to old RBCs after ~120 days?",
          "back": "Macrophages—especially in spleen/lymphoid tissue—break them into heme and globin.",
          "tags": [
            "RBC",
            "Turnover"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c14",
          "front": "What happens to heme after RBC breakdown?",
          "back": "Heme → iron + biliverdin; biliverdin → bilirubin for biliary excretion.",
          "tags": [
            "RBC",
            "Turnover"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c15",
          "front": "What does hematocrit measure?",
          "back": "The percentage of whole-blood volume occupied by RBCs.",
          "tags": [
            "RBC",
            "Hematocrit"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c16",
          "front": "What lowers vs raises hematocrit?",
          "back": "Anemia/overhydration/pregnancy lower it; polycythemia/dehydration raise it.",
          "tags": [
            "RBC",
            "Hematocrit"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c17",
          "front": "What causes RBC sedimentation in ESR?",
          "back": "Rouleaux formation.",
          "tags": [
            "RBC",
            "ESR"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        },
        {
          "id": "1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV-c18",
          "front": "Is ESR diagnostic of a specific disease?",
          "back": "No. It is nonspecific and mainly useful as a prognostic/follow-up test.",
          "tags": [
            "RBC",
            "ESR"
          ],
          "source_url": "https://docs.google.com/presentation/d/1-wHCgQkGIWBnewjyPSoHjdu1CLk52vrV/edit?usp=drivesdk&ouid=102134342085822761643&rtpof=true&sd=true"
        }
      ]
    },
    {
      "id": "drive_1akREae-VDZN_QNeQlrnBruB1ML_EVnFr",
      "subject": "Biochemistry",
      "title": "Heme Synthesis",
      "source_file_id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr",
      "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk",
      "source_modified_time": "2026-08-31T22:58:24.107Z",
      "archived": false,
      "cards": [
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c01",
          "front": "What is heme structurally?",
          "back": "An iron-containing porphyrin made of four pyrrole rings linked by methenyl bridges.",
          "tags": [
            "Heme synthesis"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c02",
          "front": "Which organs are major sites of heme synthesis?",
          "back": "Liver and erythroid bone marrow.",
          "tags": [
            "Heme synthesis"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c03",
          "front": "Where do the steps of heme synthesis occur?",
          "back": "First step + last 3 steps in mitochondria; intermediate steps in cytosol.",
          "tags": [
            "Heme synthesis"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c04",
          "front": "What is the rate-limiting step of heme synthesis?",
          "back": "ALA synthase forming δ-ALA from glycine + succinyl-CoA.",
          "tags": [
            "Heme synthesis",
            "ALA synthase"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c05",
          "front": "Which cofactor does ALA synthase require?",
          "back": "Pyridoxal phosphate (vitamin B6).",
          "tags": [
            "Heme synthesis",
            "ALA synthase"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c06",
          "front": "What converts ALA to porphobilinogen?",
          "back": "ALA dehydratase (PBG synthase); it is inhibited by lead.",
          "tags": [
            "Heme synthesis",
            "Lead"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c07",
          "front": "What is the first pyrrole-containing intermediate?",
          "back": "Porphobilinogen (PBG).",
          "tags": [
            "Heme synthesis"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c08",
          "front": "What does PBG deaminase make?",
          "back": "Four PBG molecules → hydroxymethylbilane.",
          "tags": [
            "Heme synthesis",
            "Porphyria"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c09",
          "front": "What happens without uroporphyrinogen III synthase?",
          "back": "Hydroxymethylbilane converts nonenzymatically to uroporphyrinogen I.",
          "tags": [
            "Heme synthesis"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c10",
          "front": "Which heme-synthesis enzymes are inhibited by lead?",
          "back": "ALA dehydratase, coproporphyrinogen oxidase, and ferrochelatase.",
          "tags": [
            "Heme synthesis",
            "Lead"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c11",
          "front": "What does ferrochelatase do?",
          "back": "Inserts iron into protoporphyrin IX to form heme.",
          "tags": [
            "Heme synthesis",
            "Ferrochelatase"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c12",
          "front": "How does heme regulate its own synthesis in liver?",
          "back": "Heme/hemin inhibits hepatic ALA synthase.",
          "tags": [
            "Heme synthesis",
            "Regulation"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c13",
          "front": "Why can phenobarbital or griseofulvin increase ALA synthase?",
          "back": "They induce CYP450, consume heme, lower hepatic heme, and release ALA synthase from inhibition.",
          "tags": [
            "Heme synthesis",
            "Regulation"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c14",
          "front": "Why do early-pathway porphyrias cause neurovisceral symptoms?",
          "back": "ALA and PBG accumulate; they are neurotoxic.",
          "tags": [
            "Porphyria"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c15",
          "front": "Why do later-pathway porphyrias cause photosensitivity?",
          "back": "Porphyrins accumulate, absorb light, form free radicals, and damage skin.",
          "tags": [
            "Porphyria"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c16",
          "front": "Best test during an acute porphyria attack?",
          "back": "Urinary PBG measurement.",
          "tags": [
            "Porphyria",
            "Diagnosis"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c17",
          "front": "How does IV hemin help acute porphyria?",
          "back": "It suppresses ALA synthase activity.",
          "tags": [
            "Porphyria",
            "Treatment"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        },
        {
          "id": "1akREae-VDZN_QNeQlrnBruB1ML_EVnFr-c18",
          "front": "Preferred test for lead poisoning?",
          "back": "Blood lead level because lead concentrates in erythrocytes.",
          "tags": [
            "Lead",
            "Diagnosis"
          ],
          "source_url": "https://drive.google.com/file/d/1akREae-VDZN_QNeQlrnBruB1ML_EVnFr/view?usp=drivesdk"
        }
      ]
    },
    {
      "id": "drive_1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b",
      "subject": "Biochemistry",
      "title": "Plasma Lipoprotein Metabolism",
      "source_file_id": "1QehG6qeRVqmRzs6LnoK7_DUmMlCUfs6b",
